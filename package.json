{
  "name": "@trailofbits/vsix-audit",
  "version": "0.3.0",
  "description": "Security scanner for VS Code extensions",
  "keywords": [
    "audit",
    "scanner",
    "security",
    "trail-of-bits",
    "vscode",
    "vsix"
  ],
  "homepage": "https://github.com/trailofbits/vsix-audit#readme",
  "bugs": {
    "url": "https://github.com/trailofbits/vsix-audit/issues"
  },
  "license": "AGPL-3.0",
  "author": "Trail of Bits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trailofbits/vsix-audit.git"
  },
  "bin": {
    "vsix-audit": "dist/index.js"
  },
  "files": [
    "dist",
    "zoo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#internal/*": "./dist/*"
  },
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:cli": "npm run build && vitest run --config vitest.cli.config.ts",
    "test:docker": "node scripts/test-docker.mjs",
    "test:watch": "vitest",
    "lint": "npm run build && oxlint --type-aware --max-warnings=0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && npm run typecheck:scripts",
    "corpus:download": "npm run build && node scripts/download-clean-corpus.mjs",
    "corpus:report": "npm run build && node scripts/report-clean-corpus.mjs",
    "corpus:check": "npm run build && node scripts/report-clean-corpus.mjs --fail-on-never",
    "check:static": "npm run typecheck && npm run lint && npm run format:check",
    "check": "npm run check:static && npm test && npm run test:cli",
    "prepublishOnly": "npm run check && npm run build",
    "typecheck:scripts": "npm run build && tsc --noEmit --project tsconfig.scripts.json",
    "findings:collect": "npm run --silent build && node scripts/collect-findings.ts"
  },
  "dependencies": {
    "@eslint-community/regexpp": "4.12.2",
    "commander": "15.0.0",
    "oxc-parser": "0.155.0",
    "picocolors": "1.1.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/yauzl": "3.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
